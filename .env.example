MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DBNAME=your_database
# Токен бота: им проверяются данные входа из Telegram
TELEGRAM_BOT_TOKEN=123456:your_bot_token
# Адрес сайта для проверки Origin (защита от CSRF). Если не задан, берётся заголовок Host
APP_ORIGIN=https://friday-poker.ru
# Ссылка на мини-приложение: «Поделиться» игрой открывает её прямо в Telegram
# (для основного мини-приложения бота подойдёт и https://t.me/<бот>)
TELEGRAM_APP_URL=https://t.me/your_bot/app
